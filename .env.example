# ==========================================
# Daily Protein Design SOTA Agent Configuration
# ==========================================

# 1. Gmail Configuration
# GMAIL_USER: Your full Gmail address (e.g., yourname@gmail.com)
GMAIL_USER=your_email@gmail.com

# GMAIL_APP_PASSWORD: 16-character App Password generated from Google Account
# How to get it:
# 1. Visit: https://myaccount.google.com/apppasswords
# 2. (Ensure 2-Step Verification is turned ON for your Google account)
# 3. Enter app name (e.g. "ProteinAgent") and click Create.
# 4. Copy the 16-character code (remove spaces) and paste below.
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# RECIPIENT_EMAIL: The email address to receive the daily digest (usually same as GMAIL_USER)
RECIPIENT_EMAIL=your_email@gmail.com

# 2. Gemini AI Configuration (Optional but Recommended)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 3. Tuning Options
FETCH_LOOKBACK_DAYS=3
MAX_PAPERS_PER_SOURCE=15
MIN_RELEVANCE_SCORE=6
MAX_PAPERS_IN_DIGEST=12

